{
    "name": "launchoms/module-order-push",
    "description": "Pushes newly placed Magento orders to a LaunchOMS webhook endpoint (POST /api/webhooks/magento/<channelId>/orders-create).",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0",
        "magento/framework": "*",
        "magento/module-sales": "*",
        "magento/module-checkout": "*",
        "magento/module-config": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "LaunchOms\\OrderPush\\": ""
        }
    }
}
